# =============================
# APAC Compliance Agent — Environment Variables
# Copy to .env.local and fill in values
# =============================

# ---- Network ----
# Set to "base-sepolia" for testnet, leave empty for mainnet
NEXT_PUBLIC_NETWORK=base-sepolia

# ---- x402 Payment ----
# Base address that receives USDC payments for KYC audits
PAYMENT_RECEIVE_ADDRESS=0xYourBaseAddressHere

# ---- World ID ----
WORLD_APP_ID=app_your_world_app_id
WORLD_ACTION_ID=kyc-verify
# Set to "true" in local dev to skip real World ID verification
WORLD_DEV_BYPASS=false

# ---- AML / Sanctions ----
# OFAC API key (https://home.treasury.gov/policy-issues/office-of-foreign-assets-control-sanctions-programs-and-information)
OFAC_API_KEY=

# OpenSanctions API key (https://www.opensanctions.org/api/)
OPENSANCTIONS_API_KEY=

# ---- Japan ----
# NTA Corporate Number API key (https://www.houjin-bangou.nta.go.jp/)
HOUJIN_API_KEY=

# ---- Singapore ----
# data.gov.sg does not require an API key for public datasets

# ---- Hong Kong ----
# Companies Registry Open Data API key (optional; falls back to format validation)
HK_CR_API_KEY=

# ---- Australia ----
# ABR ABN Lookup GUID (https://abr.business.gov.au/Tools/WebServices)
ABR_GUID=

# ---- Korea ----
# 공공데이터포털 API key (https://www.data.go.kr/)
KOREA_DATA_GO_KR_API_KEY=

# ---- CORS ----
# Allowed origin for API CORS (use * for open access or specify your domain)
CORS_ORIGIN=*
